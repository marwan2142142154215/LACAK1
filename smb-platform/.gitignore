# SMB Platform monorepo — root ignores
# Per-component ignore files handle their own trees; this covers shared artifacts.

# Runtime logs written by scripts/start-all.ps1
logs/

# Secrets — must never be committed
.env
.env.*
!.env.example

# Published mobile binaries (generated by scripts/publish-downloads.ps1)
smb-downloads/*.apk

# Node / build output that may appear outside component folders
**/node_modules/
