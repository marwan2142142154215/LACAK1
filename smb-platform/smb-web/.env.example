# SMB Web — contoh konfigurasi. Salin ke .env.local dan isi nilainya.
# JANGAN commit .env / .env.local.

# URL API Laravel (dev memakai proxy Vite, produksi diarahkan ke api.lacaksmbbot.com)
VITE_API_BASE_URL=/api/v1

# Sentry opsional — kosongkan untuk menonaktifkan
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=production
